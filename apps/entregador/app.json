{
  "expo": {
    "name": "CLICK-FOOD Entregador",
    "slug": "click-food-entregador",
    "owner": "galego-ais-team",
    "scheme": "clickfood-entregador",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/clickfood-entregador-icon.png",
    "splash": {
      "image": "./assets/clickfood-entregador-splash.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "./plugins/withClickFoodFloatingBubble",
      "./plugins/withClickFoodAndroidBuildTuning",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O CLICK-FOOD usa sua localização enquanto você está online para encontrar entregas próximas e acompanhar entregas ativas.",
          "locationAlwaysAndWhenInUsePermission": "Permita que o CLICK-FOOD Entregador use sua localização sempre que você estiver online, inclusive em segundo plano, para receber chamadas e acompanhar entregas ativas.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F4C400",
          "defaultChannel": "clickfood-alertas",
          "sounds": [
            "./assets/clickfood_alerta.wav",
            "./assets/clickfood_chamada.wav"
          ]
        }
      ]
    ],
    "android": {
      "package": "br.com.clickfood.entregador",
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "br.com.clickfood.entregador",
      "supportsTablet": false
    },
    "extra": {
      "eas": {
        "projectId": "7647708c-4646-4e28-a4e1-e037acaec186"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7647708c-4646-4e28-a4e1-e037acaec186",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
