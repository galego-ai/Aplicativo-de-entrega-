{
  "expo": {
    "name": "CLICK-FOOD Cliente",
    "slug": "click-food-cliente",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      ["expo-location", {"locationWhenInUsePermission": "O CLICK-FOOD usa sua localização para calcular a entrega até o endereço informado."}],
      ["expo-notifications", {"color": "#F4C400", "defaultChannel": "clickfood-default"}]
    ],
    "android": {
      "package": "br.com.clickfood.cliente",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "ios": {
      "bundleIdentifier": "br.com.clickfood.cliente",
      "supportsTablet": true
    }
  }
}
