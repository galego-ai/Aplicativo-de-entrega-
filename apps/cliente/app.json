{
  "expo": {
    "name": "CLICK-FOOD Cliente",
    "slug": "click-food-cliente",
    "owner": "galego-ais-team",
    "scheme": "clickfood-cliente",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O CLICK-FOOD usa sua localização para calcular a entrega até o endereço informado."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F4C400",
          "defaultChannel": "clickfood-alertas",
          "sounds": [
            "./assets/clickfood_alerta.wav",
            "./assets/clickfood_chamada.wav"
          ]
        }
      ]
    ],
    "android": {
      "package": "br.com.clickfood.cliente",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "br.com.clickfood.cliente",
      "supportsTablet": true
    },
    "extra": {
      "eas": {
        "projectId": "52e2d5ff-faaa-4245-8564-47b9a4963fbb"
      }
    }
  }
}
